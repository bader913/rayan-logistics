# ==========================================
# Rayan Logistics - Environment Configuration Example
# ==========================================
# Copy this file to .env and adjust values for your environment.

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL Database Configuration
# Option A: Connection URL (Recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rayan_logistics

# Option B: Discrete Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rayan_logistics
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000

# Security & Authentication
JWT_SECRET=rayan_logistics_jwt_ultra_secret_key_minimum_32_characters_long_12345
JWT_EXPIRES_IN=7d
COOKIE_SECRET=rayan_logistics_cookie_secret_67890

# Initial Admin User Credentials (Used by npm run create:admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@rayanlogistics.org
ADMIN_PASSWORD=AdminSecurePass123!

# AI Studio injected variables (Optional)
GEMINI_API_KEY=

